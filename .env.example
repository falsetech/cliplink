# CLIPLINK environment variables
#
# Every variable here is OPTIONAL. With none of them set, the app runs fully
# on an in-memory store and a process-local event bus — enough to develop
# against and to round-trip clips between two tabs on one machine.
#
# Copy to .env.local:  cp .env.example .env.local

# --- Storage (Upstash Redis REST) -------------------------------------------
# Rooms, clips, and atomic per-IP rate limiting.
# Without these, lib/cliplink/storage.ts falls back to an in-memory store:
# state is lost on restart and is not shared across server instances.
# The Vercel Upstash integration's KV_REST_API_URL / KV_REST_API_TOKEN are
# also accepted as aliases (see lib/cliplink/redis.ts).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Realtime fan-out (Redis pub/sub over rediss://) ------------------------
# Delivers clips and WebRTC signaling across server instances.
# Without it, WebSocket fan-out is process-local only (see lib/cliplink/pubsub.ts).
# REDIS_URL and KV_URL are also accepted as aliases.
UPSTASH_REDIS_URL=

# --- WebRTC ICE servers (optional) ------------------------------------------
# JSON array of RTCIceServer objects. Defaults to public STUN servers.
# Set this to add a TURN relay for peers behind restrictive NATs, where a
# direct peer-to-peer connection cannot be established.
# Example:
# NEXT_PUBLIC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]
NEXT_PUBLIC_ICE_SERVERS=
